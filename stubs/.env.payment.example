# ─────────────────────────────────────────────────────────────────────────────
# STRIPE — Variables à ajouter dans votre .env
# ─────────────────────────────────────────────────────────────────────────────
# Récupérez ces clés sur https://dashboard.stripe.com/apikeys

# Clé publique (exposée au JS frontend)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé secrète (backend uniquement, ne jamais exposer)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret du webhook (généré dans Dashboard Stripe > Webhooks)
# En local avec Stripe CLI : stripe listen --forward-to localhost/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de base de l'application (utilisée pour le return_url Stripe)
APP_URL=http://localhost
