{
    "name": "astral-php/astral-payment",
    "description": "Intégration Stripe pour Astral — PaymentIntent, webhooks, events, remboursements",
    "type": "library",
    "version": "0.1.2",
    "license": "MIT",
    "keywords": [
        "astral",
        "php",
        "stripe",
        "payment",
        "webhook"
    ],
    "authors": [
        {
            "name": "astral-php",
            "homepage": "https://github.com/astral-php"
        }
    ],
    "homepage": "https://github.com/astral-php/astral-payment",
    "support": {
        "source": "https://github.com/astral-php/astral-payment",
        "issues": "https://github.com/astral-php/astral-payment/issues"
    },
    "require": {
        "php": "^8.1",
        "astral-php/astral-core": "^1.2",
        "stripe/stripe-php": "^13.0 || ^14.0 || ^15.0 || ^16.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AstralPayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AstralPayment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "astral-payment": {
            "stubs": "stubs"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
